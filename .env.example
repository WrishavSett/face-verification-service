# ---------------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
# ---------------------------------------------------------------------------

# InsightFace model pack to use.
# Options: buffalo_l (most accurate), buffalo_m, buffalo_s (faster, less accurate)
INSIGHTFACE_MODEL=buffalo_l

# Face detection input size (width, height).
# Larger values improve accuracy at the cost of speed.
DET_SIZE=(640, 640)

# Cosine similarity threshold for verification decision.
# Range: 0.0 – 1.0. Start conservative; tune downward based on empirical results.
# buffalo_l typical operating range: 0.55 – 0.75
SIMILARITY_THRESHOLD=0.60

# Directory where enrolled reference photos are stored.
PHOTO_DIR=storage/student_photos

# API route prefix.
API_V1_PREFIX=/api/v1

# Human-readable service name (appears in OpenAPI docs).
PROJECT_NAME=Face Verification Service